# Sisuraksha shared network values
# Update this single file when hotspot/IP values change.

# Common identity
DRIVER_ID=8c394627-e397-4bd5-928f-4cc66cfebac1

# Main laptop/backend IP.
# Change this when hotspot assigns a new laptop IP.
SISURAKSHA_SERVER_HOST=10.33.31.198
SISURAKSHA_SERVER_PORT=5000

# Phone camera (IP Webcam)
PHONE_IP=192.168.1.110:8080

# Footboard camera source: phone or esp32cam
FOOTBOARD_CAMERA_SOURCE=phone

# ESP32-CAM MJPEG stream server uses port 81 in CameraWebServer/app_httpd.cpp.
# Replace with the IP printed by CameraWebServer serial output if mDNS is not reliable.
ESP32_CAM_IP=192.168.1.115:81

# Footboard ESP32 (informational/default wiring value)
ESP32_IR_IP=192.168.1.106

# Backend URLs
FOOTBOARD_SERVER_URL=http://10.33.31.198:5000/api/safety
DRIVER_MONITOR_SERVER_URL=http://10.33.31.198:5000/api/driver-monitor
WINDOW_SAFETY_SERVER_URL=http://10.33.31.198:5000/api/window-safety

# Footboard webhook listener port (Python Flask)
FOOTBOARD_WEBHOOK_PORT=5001
